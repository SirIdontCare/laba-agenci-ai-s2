# Skopiuj ten plik jako .env.local (obok package.json) i uzupełnij wartości.
# Pliku .env.local nie wysyłasz nikomu i nie wrzucasz na GitHub.

# Klucz z prywatnej wiadomości od LABA
OPENROUTER_API_KEY=

# Model do rozmowy (Gemini obsługuje wyszukiwanie Google i zdjęcia)
OPENROUTER_MODEL=google/gemini-3.8-flash

# Lekcja 5 — baza Supabase (te same wartości co na lekcji 5)
# Adres projektu: Supabase → Connect → Project URL, np. https://abcdefgh.supabase.co
SUPABASE_URL=
# Klucz secret: Supabase → Settings → API Keys, zaczyna się od sb_secret_
# Używa go tylko serwer (wspólna baza wiedzy). Nigdy nie dodawaj do nazwy przedrostka NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# Lekcja 7 — logowanie przez Supabase Auth (konta użytkowników)
# Adres projektu — ten sam co w SUPABASE_URL: Supabase → Connect → Project URL
NEXT_PUBLIC_SUPABASE_URL=
# Klucz publishable: Supabase → Settings → API Keys, zaczyna się od sb_publishable_
# Może trafić do przeglądarki: sam niczego nie otwiera, danych pilnują reguły RLS w bazie.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Lekcja 6 — model embeddingów: zamienia tekst na listę liczb dla bazy wiedzy.
# Ten sam model służy do zapisu dokumentów i do pytań. Zwraca 1536 liczb — tyle, ile kolumna embedding w baza.sql.
OPENROUTER_EMBEDDING_MODEL=openai/text-embedding-3-small
