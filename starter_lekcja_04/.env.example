# Skopiuj ten plik jako .env.local (obok package.json) i uzupełnij wartości.
# Pliku .env.local nie wysyłasz nikomu i nie wrzucasz na GitHub.

# Klucz z prywatnej wiadomości od LABA
OPENROUTER_API_KEY=

# Model do rozmowy (Gemini obsługuje wyszukiwanie Google i zdjęcia)
OPENROUTER_MODEL=google/gemini-3.8-flash

# Hasło do Twojego chatbota (wymyślasz sam)
CHAT_PASSWORD=

# Długi losowy ciąg znaków do podpisywania sesji (poproś asystenta o wygenerowanie)
SESSION_SECRET=
